# =====================================================================
# HYBRID PERSONAL FINANCE & SHOPEEFOOD DRIVER TRACKER CONFIGURATION
# =====================================================================

# 1. Telegram Bot Token (Dapatkan dari @BotFather di Telegram)
# Biarkan default jika hanya ingin menjalankan Web Dashboard lokal
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# 2. Google Sheets Configuration
# File credentials.json (Google Service Account) diletakkan di root folder
GOOGLE_SHEET_NAME="Database_Keuangan"
GOOGLE_CREDENTIALS_FILE="credentials.json"

# 3. Storage Mode:
# "auto"          -> Gunakan Google Sheets jika credentials.json ada, otomatis fallback ke SQLite jika tidak ada
# "sqlite"        -> Selalu gunakan SQLite lokal (keuangan.db)
# "google_sheets" -> Paksa gunakan Google Sheets
STORAGE_MODE="auto"

# 4. Target Finansial Ojol Bulanan (Rupiah)
TARGET_OJOL_BULANAN=1000000
TARGET_OJOL_MILESTONE=500000

# 5. Konfigurasi Spesifikasi Motor (Honda BeAT 2021)
KONSUMSI_BBM_KM_PER_LITER=54.0
HARGA_BENSIN_PER_LITER=10000
BIAYA_SERVIS_PER_KM=150

# 6. Web Server Configuration
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY="shopeefood-personal-finance-hybrid-secret"
